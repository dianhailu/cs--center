# Copy to .env.production on the VPS (never commit real values)

POSTGRES_USER=cs
POSTGRES_PASSWORD=change-me-strong-db-password
POSTGRES_DB=cs_midplatform

JWT_SECRET=change-me-long-random-jwt-secret
WEBHOOK_SECRET=change-me-webhook-secret
# Comma-separated Cloudflare Pages origins
CORS_ORIGINS=https://cs.originmount.com

LIVEAGENT_BASE_URL=https://pingo.ladesk.com
LIVEAGENT_API_V3_KEY=
LIVEAGENT_API_V1_KEY=
LIVEAGENT_AGENT_EMAIL=
LIVEAGENT_DRY_RUN=false
# Transfer chat to LIVEAGENT_AGENT_EMAIL before AI replies (skip ring/accept popup)
LIVEAGENT_AUTO_TRANSFER=true

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
DEFAULT_REPLY_LANG=id
MIN_FAQ_SCORE=0.18
MIN_HISTORY_SCORE=0.22
AI_ENABLED=true

# Smart evening learning from customer↔PinGo CS chats (worker built-in schedule)
# Default: every day at 22:00 Asia/Jakarta; full rebuild from DB (= history + today's chats)
HISTORY_LEARN_ENABLED=true
HISTORY_LEARN_HOUR=22
HISTORY_LEARN_TIMEZONE=Asia/Jakarta
HISTORY_LEARN_LIMIT_CONVERSATIONS=8000

SEED_AGENT_EMAIL=agent@pingo.com
SEED_AGENT_PASSWORD=change-me-agent-password
