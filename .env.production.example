# Copy to .env.production on the VPS (never commit real values)

POSTGRES_USER=cs
POSTGRES_PASSWORD=change-me-strong-db-password
POSTGRES_DB=cs_midplatform

JWT_SECRET=change-me-long-random-jwt-secret
WEBHOOK_SECRET=change-me-webhook-secret
# Comma-separated Cloudflare Pages origins
CORS_ORIGINS=https://cs.originmount.com

LIVEAGENT_BASE_URL=https://pingo.ladesk.com
LIVEAGENT_API_V3_KEY=
LIVEAGENT_API_V1_KEY=
LIVEAGENT_AGENT_EMAIL=
LIVEAGENT_DRY_RUN=false
# Transfer chat to LIVEAGENT_AGENT_EMAIL before AI replies (skip ring/accept popup)
LIVEAGENT_AUTO_TRANSFER=true
# LoginKey pickUpChat + createAnswer on type-C message group id (visitor-visible)
LIVEAGENT_PANEL_ACCEPT=true
# Keep PinGo CS always online for visitors (Devices API keep-alive)
LIVEAGENT_KEEP_ONLINE=true
LIVEAGENT_KEEP_ONLINE_INTERVAL_SEC=60
# Optional: pin agent/department ids (else resolve from email / departments list)
# LIVEAGENT_AGENT_USER_ID=
# LIVEAGENT_CHAT_DEPARTMENT_ID=

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Aliyun HK: api.openai.com returns 403 unsupported_country_region_territory.
# Singapore is fine for OpenAI — pick ONE egress approach:
# Singapore VPN/proxy example (pick one approach):
# OPENAI_PROXY=http://user:pass@host:port
# or HTTPS_PROXY=...
# OPENAI_BASE_URL=https://api.openai.com/v1  # default
# (Also accepts HTTP_PROXY / ALL_PROXY / socks5://host:port)
# Alternative: point BASE_URL at an OpenAI-compatible gateway instead of using a VPN.
OPENAI_BASE_URL=https://api.openai.com/v1
DEFAULT_REPLY_LANG=id
MIN_FAQ_SCORE=0.18
MIN_HISTORY_SCORE=0.22
AI_ENABLED=true
# false = Smart replies midplatform-only (agents review quality); no visitor/LA delivery
# Prod may set true when ready (env override); keep example false for safe new deploys
# Flip to true + recreate api/worker when learning quality is OK
AI_SEND_TO_CUSTOMER=false

# Smart evening learning from customer↔PinGo CS chats (worker built-in schedule)
# Default: every day at 22:00 Asia/Jakarta; full rebuild from DB (= history + today's chats)
HISTORY_LEARN_ENABLED=true
HISTORY_LEARN_HOUR=22
HISTORY_LEARN_TIMEZONE=Asia/Jakarta
HISTORY_LEARN_LIMIT_CONVERSATIONS=8000

# Promote high-quality human agent replies into faq.json after HISTORY_LEARN
FAQ_AUTO_PROMOTE=true
FAQ_PROMOTE_MAX_PER_NIGHT=50
FAQ_PROMOTE_MIN_ANSWER_CHARS=20
FAQ_PROMOTE_MAX_ANSWER_CHARS=2000
FAQ_PROMOTE_MIN_QUESTION_CHARS=8
FAQ_PROMOTE_MIN_REPEAT=2
FAQ_PROMOTE_DEDUPE_SIMILARITY=0.82
FAQ_PROMOTE_CATEGORY_SIMILARITY=0.35

SEED_AGENT_EMAIL=agent@pingo.com
SEED_AGENT_PASSWORD=change-me-agent-password
# Optional system admin (set both on VPS; never commit real values)
# SEED_ADMIN_EMAIL=admin@example.com
# SEED_ADMIN_PASSWORD=change-me-admin-password

DEFAULT_PRODUCT_CODE=pingo
DEFAULT_COUNTRY_CODE=ID

# Optional: Avantee (separate LiveAgent at avantee.ladesk.com)
# AVANTEE_LIVEAGENT_BASE_URL=https://avantee.ladesk.com
# AVANTEE_LIVEAGENT_API_V3_KEY=
# AVANTEE_LIVEAGENT_API_V1_KEY=
# AVANTEE_LIVEAGENT_AGENT_EMAIL=
# AVANTEE_LIVEAGENT_DRY_RUN=false
# AVANTEE_PRODUCT_CODE=avantee
# AVANTEE_COUNTRY_CODE=ID
# AVANTEE_CUSTOMER_REPLY_LANG=id
