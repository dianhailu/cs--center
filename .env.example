DATABASE_URL=sqlite+pysqlite:////Users/lu/Desktop/cursor/cs-midplatform/backend/cs.db
REDIS_URL=redis://127.0.0.1:6379/0
JWT_SECRET=change-me-jwt-secret
WEBHOOK_SECRET=dev-secret
CORS_ORIGINS=http://localhost:3000

# Seed / default LiveAgent connection for workspace pingo-id
LIVEAGENT_BASE_URL=https://pingo.ladesk.com
LIVEAGENT_API_V3_KEY=
LIVEAGENT_API_V1_KEY=
LIVEAGENT_AGENT_EMAIL=
LIVEAGENT_DRY_RUN=true
# Transfer chat to LIVEAGENT_AGENT_EMAIL before AI replies (skip ring/accept popup)
LIVEAGENT_AUTO_TRANSFER=true
# Keep PinGo CS always online for visitors (Devices API; independent of auto-transfer)
LIVEAGENT_KEEP_ONLINE=true
LIVEAGENT_KEEP_ONLINE_INTERVAL_SEC=60
# Optional overrides (otherwise resolve via LIVEAGENT_AGENT_EMAIL / departments API)
# LIVEAGENT_AGENT_USER_ID=
# LIVEAGENT_CHAT_DEPARTMENT_ID=

# AI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Official API root (default). On Aliyun HK use a Singapore VPN/proxy instead of changing this.
OPENAI_BASE_URL=https://api.openai.com/v1
# Optional: OpenAI-only proxy (also honors HTTPS_PROXY / HTTP_PROXY / ALL_PROXY)
# OPENAI_PROXY=http://user:pass@host:port
# OPENAI_PROXY=socks5://host:port
DEFAULT_REPLY_LANG=id
MIN_FAQ_SCORE=0.18
MIN_HISTORY_SCORE=0.22
AI_ENABLED=true
# false = Smart replies stay in midplatform only (agents can review); no LA/visitor delivery
# true  = resume posting AI replies to LiveAgent / customers
AI_SEND_TO_CUSTOMER=false

# Smart evening learning (worker): rebuild history_pairs.json from DB
HISTORY_LEARN_ENABLED=true
HISTORY_LEARN_HOUR=22
HISTORY_LEARN_TIMEZONE=Asia/Jakarta
HISTORY_LEARN_LIMIT_CONVERSATIONS=8000

# Demo agent login
SEED_AGENT_EMAIL=agent@pingo.com
SEED_AGENT_PASSWORD=agent123
# Optional system admin (created on seed when both set; do not commit real secrets)
# SEED_ADMIN_EMAIL=admin@example.com
# SEED_ADMIN_PASSWORD=change-me-admin-password

# Multi-product defaults (existing conversations/FAQ backfill to these)
DEFAULT_PRODUCT_CODE=pingo
DEFAULT_COUNTRY_CODE=ID
